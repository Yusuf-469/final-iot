# ==============================================
# Medical IoT Backend - Environment Variables
# ==============================================

# Server Configuration
NODE_ENV=development
PORT=3000

# Firebase Configuration (Realtime Database + Auth token verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Alternative: GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# JWT Authentication - REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out.
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# IoT devices (optional): when set, ESP32s must send header  X-Device-Key: <value>
# when posting to /api/health-data, /api/alerts and /api/devices/heartbeat
DEVICE_API_KEY=

# Alert engine worker (npm run worker) - watches device nodes and raises alerts in real time
# ALERT_DEVICE_NODES=health
# ALERT_SWEEP_SEC=60
# Engine thresholds can be overridden live in Firebase at /alertEngine/config, e.g.
#   { "tempOffsetC": 2.5, "cooldownMin": 20, "baseline": { "zThreshold": 4 } }
# (tempOffsetC converts a fingertip/skin sensor reading to an estimated core temperature)

# Dr. AI chat (optional): without a key, Dr. AI uses built-in rule-based answers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Alert notifications (optional). Each channel is used only when its settings are present.
# Warning and critical alerts are emailed / texted to these care-team recipients when created or escalated.
ALERT_EMAIL_TO=
ALERT_SMS_TO=
# ALERT_NOTIFY_SEVERITIES=warning,critical
# Email via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
